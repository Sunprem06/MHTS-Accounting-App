{
  "name": "@mhts/desktop-shell",
  "version": "1.0.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "generate-icon": "node scripts/generate-placeholder-icon.mjs",
    "package:win": "npm run generate-icon && electron-builder --win --publish never",
    "package:mac": "npm run generate-icon && electron-builder --mac --publish never",
    "package:linux": "npm run generate-icon && electron-builder --linux --publish never",
    "release": "npm run generate-icon && electron-builder --win --mac --linux --publish always"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron-updater": "^6.3.9",
    "lucide-react": "^1.42.0",
    "node-machine-id": "^1.1.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@mhts/core-accounting": "*",
    "@mhts/core-audit": "*",
    "@mhts/core-banking": "*",
    "@mhts/core-company-profile": "*",
    "@mhts/core-documents": "*",
    "@mhts/core-expense": "*",
    "@mhts/core-fixed-assets": "*",
    "@mhts/core-gst-engine": "*",
    "@mhts/core-identity": "*",
    "@mhts/core-inventory": "*",
    "@mhts/core-licensing": "*",
    "@mhts/core-manufacturing": "*",
    "@mhts/core-payroll-engine": "*",
    "@mhts/core-rules-engine": "*",
    "@mhts/core-sales-purchase": "*",
    "@mhts/db-schema": "*",
    "@mhts/print-templates": "*",
    "@mhts/shared-types": "*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "pngjs": "^7.0.0",
    "vite": "^5.4.11"
  }
}
