{
  "name": "desktop-shell",
  "sourceRoot": "apps/desktop-shell/src",
  "projectType": "application",
  "tags": ["type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "electron-vite build",
        "cwd": "apps/desktop-shell"
      },
      "outputs": ["{projectRoot}/out"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "electron-vite dev",
        "cwd": "apps/desktop-shell"
      }
    }
  }
}
